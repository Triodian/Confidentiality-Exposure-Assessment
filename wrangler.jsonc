// Cloudflare Worker configuration for the AI Confidentiality Exposure Assessment. Cloudflare reads this file on every deploy from GitHub.
// Same shape as the AI Use Assessment Worker (Triodian/use-assessment); only the names, addresses and databases differ.
{
  "name": "confidentiality-exposure-assessment",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // run_worker_first: every request reaches src/worker.js first, so pages can require sign-in (lib/identity/session.js).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  // Only reachable at the custom domain. People sign in at /login; Cloudflare Access guards /auth/email only.
  // The default workers.dev address and preview addresses are switched off.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "confidentiality.triodian.com", "custom_domain": true }],

  // SET-UP STEP 1: create the database (`npx wrangler d1 create confidentiality-exposure-db`) and paste its id here.
  "d1_databases": [
    { "binding": "DB", "database_name": "confidentiality-exposure-db", "database_id": "35c814fa-7fa0-4fb5-967c-d0c80352ceb3" },
    { "binding": "IDENTITY", "database_name": "triodian-identity-db", "database_id": "d2031f39-53b4-438c-aed6-1d480f9526bf" }
  ],
  // IDENTITY (development plan tasks 1B.2 and 1B.3): the suite's shared identity database, one per environment, bound to
  // all four engagement apps. With it, people are added once, roles are kept per app, and one sign-in covers every app
  // on SUITE_COOKIE_DOMAIN (the cookie SUITE_SESSION_COOKIE; the test sites use their own name so live and test stay apart).
  // Each app copies its own users in the first time it starts with the binding. The databases are triodian-identity-db
  // (live) and triodian-identity-test-db (test). Both are bound below.
  "observability": { "enabled": true },

  // Daily at 07:00 Brisbane time: remind counsel about questions open for two working days or more (lib/core/notify.js).
  "triggers": { "crons": ["0 21 * * *"] },

  // Email notifications are sent through Cloudflare Email Service from notifications@triodian.com (triodian.com must be
  // onboarded in Email Service). Until it is, each send fails and is listed as Failed in Admin → Notifications; saves are
  // never affected. To hold messages instead of sending, set NOTIFY_SENDING to "off".
  "send_email": [{ "name": "EMAIL" }],

  // DEMO_LOGIN (demo addition): the shared trio_demo sign-in, the same as the other Triodian apps so one demo
  // sign-in covers all of them. Its cookie key, DEMO_SESSION_KEY, is a Worker secret (the same value in every app). See lib/identity/session.js.
  "vars": { "SUITE_DEMO": "on", "SUITE_COOKIE_DOMAIN": "triodian.com", "SUITE_SESSION_COOKIE": "tri_suite", "NOTIFY_SENDING": "on", "NOTIFY_FROM": "notifications@triodian.com" },

  // Test copy with its own database. Deployed with `npx wrangler deploy --env test` from the `test` branch.
  "env": {
    "test": {
      "name": "confidentiality-exposure-test",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "confidentiality-test.triodian.com", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "confidentiality-exposure-test-db", "database_id": "de1439b4-9acb-42ce-ad4b-299efcaebf3c" },
        { "binding": "IDENTITY", "database_name": "triodian-identity-test-db", "database_id": "4d7591a1-bcb7-4514-b726-f0621d7de25a" }
      ],
      "vars": { "SUITE_DEMO": "on", "SUITE_COOKIE_DOMAIN": "triodian.com", "SUITE_SESSION_COOKIE": "tri_suite_test", "SITE_LABEL": "Test site", "SITE_URL": "https://confidentiality-test.triodian.com", "NOTIFY_SENDING": "on", "NOTIFY_FROM": "notifications@triodian.com" },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["0 21 * * *"] },
      "observability": { "enabled": true }
    },

    // CLIENT DEPLOYMENT PROFILE (development plan task 0.2): a copy of AI Confidentiality Exposure Assessment for one client, with no demonstration
    // parts. No demo sign-in (DEMO_LOGIN empty), no demo administrators, no demo band or app switcher (SUITE_DEMO off),
    // and DEMO_SESSION_KEY is not set as a secret. To deploy one: replace the CLIENT placeholders, create the client's
    // D1 database and put its id below, create the client's Access application for /auth/email and set its tag as
    // the ACCESS_AUD secret (the team domain is in lib/config.js), then run `npx wrangler deploy --env client`.
    // Email stays held (NOTIFY_SENDING off) until the client's sender is set up.
    "client": {
      "name": "confidentiality-exposure-client",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "confidentiality-exposure.CLIENT-DOMAIN.example", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "confidentiality-exposure-client-db", "database_id": "REPLACE-WITH-THE-CLIENT-DATABASE-ID" }
      ],
      "vars": { "SUITE_DEMO": "off", "SUITE_COOKIE_DOMAIN": "CLIENT-DOMAIN.example", "SUITE_SESSION_COOKIE": "tri_suite", "DEMO_LOGIN": "", "SITE_URL": "https://confidentiality-exposure.CLIENT-DOMAIN.example", "NOTIFY_SENDING": "off", "NOTIFY_FROM": "" },
      "send_email": [{ "name": "EMAIL" }],
      "triggers": { "crons": ["0 21 * * *"] },
      "observability": { "enabled": true }
    }
  }
}
